# Copy this file to .env for local development.
NODE_ENV=development
PORT=3000

# Must match the docker-compose.yml at the root of the repo.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ansae
DB_PASSWORD=ansae
DB_NAME=ansae

# Signs both logins' tokens. Development falls back to a fixed
# development-only secret; production refuses to start without this set
# (see src/auth/auth-guards.module.ts).
# JWT_SECRET=

# Which browser origins may call the API, comma-separated — the admin
# dashboard's URL in production. Development allows any origin; production
# allows none unless this is set.
# CORS_ORIGINS=https://admin.infunion.app

# Where uploaded voice messages and images are written when no bucket is
# set. Defaults to ./uploads next to the backend.
# UPLOADS_DIR=/var/lib/infunion/uploads

# Files in an S3-compatible bucket (Cloudflare R2 in production) instead
# of local disk, which is what lets the API run as several copies. See
# src/common/storage/file-store.ts. MIGRATE_LOCAL_FILES=on copies files
# still in UPLOADS_DIR / PRIVATE_UPLOADS_DIR into the bucket at start-up.
# S3_BUCKET=infunion-files
# S3_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MIGRATE_LOCAL_FILES=on

# One connection string instead of the DB_* variables (Railway's
# DATABASE_URL), and how many connections each copy of the API opens.
# Copies x DB_POOL_SIZE must stay under Postgres's max_connections.
# DATABASE_URL=postgresql://user:password@host:5432/railway
# DB_POOL_SIZE=10

# Which regional copy of infunion this is (eu, americas, asia), shown by
# GET /health.
# REGION=eu

# Address search pace. The public Nominatim allows one request a second;
# NOMINATIM_URL points at another one, which may allow more.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODER_MIN_INTERVAL_MS=1000

# Donations through Stripe. Leave STRIPE_SECRET_KEY empty and the donate
# screen falls back to the demo flow: the gift is recorded for the admin
# dashboard's graph, but no payment is taken.
#
# A test key (sk_test_...) from dashboard.stripe.com costs nothing, needs no
# account activation, and takes real card numbers from Stripe's test set
# (4242 4242 4242 4242, any future expiry, any CVC).
# STRIPE_SECRET_KEY=sk_test_...
DONATION_CURRENCY=eur

# Only needed if you point a real Stripe webhook at this backend. Without it
# the app still confirms payments by asking Stripe directly.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe sends the payer back after checkout. Defaults to the address
# the request came in on, which is right for localhost, a LAN IP and the
# ngrok domain alike — set it only if a proxy rewrites the host.
# PUBLIC_BASE_URL=https://your-domain.ngrok-free.app

# Push notifications go through Expo's push service, which needs no key.
# Set PUSH_NOTIFICATIONS=off to stop every send (e.g. a copy of real data).
# EXPO_ACCESS_TOKEN is only needed if "enhanced push security" is turned on
# in the Expo project.
# PUSH_NOTIFICATIONS=off
# EXPO_ACCESS_TOKEN=

# The superadmin (infunion's own section of the admin). The one address that
# is superadmin; the first boot creates the account with the initial
# password (12+ characters), which should then be removed. See README,
# "Superadmin". SUPERADMIN_RESET_2FA=yes forgets the authenticator app.
# SUPERADMIN_EMAIL=you@example.com
# SUPERADMIN_INITIAL_PASSWORD=
# SUPERADMIN_SECRET_KEY=
# SUPERADMIN_RESET_2FA=

# Sign-in codes by email (Brevo, free up to 300 emails a day). Without a
# key the code is logged and shown on screen, as for SMS. The sender's
# domain must be verified in Brevo (SPF, DKIM, DMARC on infunion.app).
# BREVO_API_KEY=
# EMAIL_FROM=register@infunion.app
# EMAIL_FROM_NAME=infunion
