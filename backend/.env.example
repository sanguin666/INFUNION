# Copy this file to .env for local development.
NODE_ENV=development
PORT=3000

# Must match the docker-compose.yml at the root of the repo.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ansae
DB_PASSWORD=ansae
DB_NAME=ansae

# Signs both logins' tokens. Development falls back to a fixed
# development-only secret; production refuses to start without this set
# (see src/auth/auth-guards.module.ts).
# JWT_SECRET=

# Which browser origins may call the API, comma-separated — the admin
# dashboard's URL in production. Development allows any origin; production
# allows none unless this is set.
# CORS_ORIGINS=https://admin.ansae.app

# Where uploaded voice messages and images are written. Defaults to
# ./uploads next to the backend. Point it at a mounted volume in production
# so files survive a deploy (see src/common/upload/multer-storage.ts).
# UPLOADS_DIR=/var/lib/ansae/uploads

# Donations through Stripe. Leave STRIPE_SECRET_KEY empty and the donate
# screen falls back to the demo flow: the gift is recorded for the admin
# dashboard's graph, but no payment is taken.
#
# A test key (sk_test_...) from dashboard.stripe.com costs nothing, needs no
# account activation, and takes real card numbers from Stripe's test set
# (4242 4242 4242 4242, any future expiry, any CVC).
# STRIPE_SECRET_KEY=sk_test_...
DONATION_CURRENCY=eur

# Only needed if you point a real Stripe webhook at this backend. Without it
# the app still confirms payments by asking Stripe directly.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe sends the payer back after checkout. Defaults to the address
# the request came in on, which is right for localhost, a LAN IP and the
# ngrok domain alike — set it only if a proxy rewrites the host.
# PUBLIC_BASE_URL=https://your-domain.ngrok-free.app

# Push notifications go through Expo's push service, which needs no key.
# Set PUSH_NOTIFICATIONS=off to stop every send (e.g. a copy of real data).
# EXPO_ACCESS_TOKEN is only needed if "enhanced push security" is turned on
# in the Expo project.
# PUSH_NOTIFICATIONS=off
# EXPO_ACCESS_TOKEN=

# The superadmin (ANSAE's own section of the admin). The one address that
# is superadmin; the first boot creates the account with the initial
# password (12+ characters), which should then be removed. See README,
# "Superadmin". SUPERADMIN_RESET_2FA=yes forgets the authenticator app.
# SUPERADMIN_EMAIL=you@example.com
# SUPERADMIN_INITIAL_PASSWORD=
# SUPERADMIN_SECRET_KEY=
# SUPERADMIN_RESET_2FA=
