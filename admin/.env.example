# Copy this file to .env for local development.
#
# URL of the backend API.
VITE_API_URL=http://localhost:3000

# Base URL of the public landing page (see the landing/ project) — the
# admin dashboard's "My QR" page encodes "<this>/?token=<poi token>#join"
# into the printable flyer's QR code. Defaults to a placeholder until a
# real domain is registered and deployed.
VITE_LANDING_URL=https://infunion.app

# Currency the donation figures are displayed in. Must match
# DONATION_CURRENCY in the backend's .env, which is what Stripe charges in.
VITE_DONATION_CURRENCY=EUR

# The mobile app's web version, shown in the phone beside the home page
# editor. `npm run start` in app/ (what start.bat runs) serves it here.
VITE_APP_PREVIEW_URL=http://localhost:8081
